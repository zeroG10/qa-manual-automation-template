{
  "name": "qa-automation-template",
  "version": "1.0.0",
  "description": "Reusable QA template: manual artifacts + Playwright (web), Appium (mobile), httpx (API). Set name/description via /setup-project.",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "pw:test": "playwright test --config=automation/web/playwright.config.ts",
    "pw:ui": "playwright test --config=automation/web/playwright.config.ts --ui",
    "pw:debug": "playwright test --config=automation/web/playwright.config.ts --debug",
    "pw:codegen": "playwright codegen",
    "pw:report": "playwright show-report automation/web/playwright/playwright-report",
    "pw:screenshot": "playwright screenshot"
  }
}
